{
  "compilerOptions": {
    "outDir": "./built",
    "sourceMap": true,
    "module": "es6",
    "target": "es5",
    "allowJs": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "downlevelIteration": true,
    "typeRoots": ["node_modules/@types", "src/types"]
  },
  "include": ["./src/**/*"]
}
